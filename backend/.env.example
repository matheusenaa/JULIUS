# Copie para .env e ajuste. O arquivo .env NUNCA deve ir para o Git.

# development | test | staging | production
APP_ENV=development

# Obrigatório em produção. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Vazio = SQLite local em backend/data/julius.db
# Produção (Neon/Supabase/etc.): postgresql+psycopg://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# Permitir novos cadastros (desligue após criar sua conta, se o app for só seu)
ALLOW_REGISTRATION=true
SESSION_DAYS=30

# --- Inteligência artificial (opcional; o app funciona sem) ---
# gemini | openai | none
AI_PROVIDER=none
# Vazio = padrão do provedor (gemini-flash-latest / gpt-4o-mini)
AI_MODEL=
# Chave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Para OpenAI ou compatíveis (Groq, OpenRouter, Ollama local em http://localhost:11434/v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Instruções do seu agente (ex.: o texto de um Gem do Gemini). Também dá para colar em Ajustes → IA.
AI_AGENT_INSTRUCTIONS_FILE=

# "Hoje" no fuso do usuário (servidores na nuvem rodam em UTC). "local" = fuso da máquina.
TIMEZONE=America/Sao_Paulo

MAX_UPLOAD_MB=8
# Arquivos de documentos: db (no próprio banco; ideal para hospedagem grátis) | local (pasta STORAGE_DIR)
STORAGE_BACKEND=db
STORAGE_DIR=

# Limites contra abuso (aumente só em testes)
LOGIN_LIMIT_PER_15MIN=8
REGISTER_LIMIT_PER_HOUR=5
AI_LIMIT_PER_MINUTE=30
